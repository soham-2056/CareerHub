# ─────────────────────────────────────────────────────────────────────────────
#  CareerHub — Server Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas (FREE) — follow these steps:
# 1. Go to https://cloud.mongodb.com  →  Sign up free
# 2. Create a FREE cluster  (M0 Sandbox)
# 3. Security → Database Access → Add user  e.g. user=soham  password=abc123
# 4. Security → Network Access → Add IP → 0.0.0.0/0  (allow from anywhere)
# 5. Clusters → Connect → Drivers → copy the URI
# 6. Replace <password> with your actual password in the URI below
MONGO_URI=mongodb+srv://soham:Soham_2056@cluster0.XXXXX.mongodb.net/careerhub?retryWrites=true&w=majority
# JWT — change this to any long random string in production
JWT_SECRET=careerhub_super_secret_jwt_key_change_in_production_2024

# Token expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# Server port
PORT=5000

# Google Gemini AI (optional — AI feedback works without it)
# Get free key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS)
ALLOWED_ORIGINS=http://localhost:5173

NODE_ENV=development
